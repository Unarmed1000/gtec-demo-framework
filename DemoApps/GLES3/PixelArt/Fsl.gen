<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../.Config/Schema/1/FslBuildGen.xsd">
  <Executable Name="GLES3.PixelArt" NoInclude="true" CreationYear="2026">
    <!-- The buffers are RGBA16F render targets -->
    <Requirement Name="GL_EXT_color_buffer_float" Type="extension" Extends="OpenGLES3"/>
    <ImportTemplate Name="DemoAppGLES3"/>
    <Dependency Name="FslUtil.EGL"/>
    <Dependency Name="Shared.PixelArt.API.OpenGLES3"/>
  </Executable>
</FslBuildGen>
