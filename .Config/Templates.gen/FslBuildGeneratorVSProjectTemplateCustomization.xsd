<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Describes the customization format FslBuildGeneratorVSProjectTemplateCustomization
	    used by the visual studio project generator.
    </xs:documentation>
  </xs:annotation>

  <xs:complexType name="_T_BuildOutput">
    <xs:attribute name="Location" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:group name="_G_BuildOutput">
    <xs:choice>
      <xs:element name="BuildOutput" type="_T_BuildOutput"/>
    </xs:choice>
  </xs:group>

  <xs:simpleType name="_T_AppContentProject">
    <xs:restriction base="xs:string">
      <xs:enumeration value="MonoGame"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="_T_AppContent">
    <xs:annotation>
      <xs:documentation>
        How the platform of the template imports the content of an app. MonoGame: generation writes the MonoGame content project
        (Content.mgcb) of an app that has content into its resolved content directory.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="Project" type="_T_AppContentProject" use="required"/>
  </xs:complexType>


  <xs:group name="_G_CustomizationList">
    <xs:sequence>
      <xs:group ref="_G_BuildOutput" minOccurs="0" maxOccurs="1"/>
      <xs:element name="AppContent" type="_T_AppContent" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:group>


  <xs:complexType name="_T_FslBuildGeneratorVSProjectTemplateCustomization">
    <xs:group ref="_G_CustomizationList"/>
    <xs:attribute name="Version" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:element name="FslBuildGeneratorVSProjectTemplateCustomization" type="_T_FslBuildGeneratorVSProjectTemplateCustomization"/>
</xs:schema>
