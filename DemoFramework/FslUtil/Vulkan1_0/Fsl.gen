      <EmbedFile Name="QUAD_BATCH_SDF_FRAG" File="OriginalContent/QuadBatchSdf.frag" Builder="VulkanShaderCompiler" Format="UInt32"/>
    </Generate>
    <Platform Name="Windows" ProjectId="879B0671-DCD6-44B5-AED6-98F133DC87BD"/>
  </Library>
</FslBuildGen>
