<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../.Config/Schema/1/FslBuildGen.xsd">
  <Library Name="FslDemoService.NativeGraphics.Vulkan" CreationYear="2017">
    <Dependency Name="FslDemoService.NativeGraphics.BasicRender"/>
