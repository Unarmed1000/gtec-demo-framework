      <EmbedFile Name="SHADER_COLOR_TEXTURE_FRAG" File="OriginalContent/RenderSystemColorTexture.frag" Builder="VulkanShaderCompiler" Format="UInt32"/>
      <EmbedFile Name="SHADER_COLOR_TEXTURE_VERT" File="OriginalContent/RenderSystemColorTexture.vert" Builder="VulkanShaderCompiler" Format="UInt32"/>
      <EmbedFile Name="SHADER_COLOR_TEXTURE_SDF_FRAG" File="OriginalContent/RenderSystemColorTextureSdf.frag" Builder="VulkanShaderCompiler" Format="UInt32"/>
    </Generate>
    <Platform Name="Windows" ProjectId="DED41996-4B0E-4963-9C6D-81334EAAA009"/>
  </Library>
</FslBuildGen>
