<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../FslBuildGen.xsd">
  <ToolRecipe Name="Recipe.BuildTool.clang" CreationYear="2017">
    <ExperimentalRecipe>
      <Installation>
        <FindExecutableFileInPath Name="clang" Alternatives="clang-23" MinVersion="23.0" VersionCommand="--version" VersionRegEx="version\s*([\d.]+)" Help="Please install clang 23.0+ (http://releases.llvm.org/download.html)"/>
        <FindExecutableFileInPath Name="clang++" Alternatives="clang++-23" MinVersion="23.0" VersionCommand="--version" VersionRegEx="version\s*([\d.]+)" Help="Please install clang++ 23.0+ (http://releases.llvm.org/download.html)"/>
      </Installation>
    </ExperimentalRecipe>
  </ToolRecipe>
</FslBuildGen>
