<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../FslBuildGen.xsd">
  <ExternalLibrary Name="Recipe.glm_1_0" AllowCheck="false" CreationYear="2020">
    <!--
    <Define Name="GLM_FORCE_DEPTH_ZERO_TO_ONE" Access="Public"/>
    <Define Name="GLM_FORCE_RADIANS" Access="Public"/>-->
  
    <Define Name="GLM_FORCE_CXX14" Access="Public"/>
    <!--ExperimentalRecipe Name="glm" Version="1.0.3" FindVersion="1.0" FindTargetName="glm::glm" CMakeDefine="glm_DIR={PACKAGE_PATH}/cmake/glm/"-->
    <ExperimentalRecipe Name="glm" Version="1.0.3" FindVersion="1.0" FindTargetName="glm::glm" Find="false">
      <Pipeline>
        <Download URL="https://github.com/g-truc/glm/releases/download/1.0.3/glm-1.0.3.zip" Hash="1c0a0fced9b0d87c7b7bc94e40be490cff6d4c83c25db8488d8f33754e7fdeb2"/>
        <Unpack File="glm-1.0.3.zip" OutputPath="glm">
          <Copy From="{OUTPUT_PATH}/glm" To="{OUTPUT_PATH}/include/glm"/>
          <Delete Path="cmake"/>
          <Delete Path="doc"/>
          <Delete Path="test"/>
          <Delete Path="util"/>
          <Delete Path="glm"/>
        </Unpack>
      </Pipeline>
      <Installation>
        <AddHeaders Name="include"/>
        <Path Name="include/glm/glm.hpp" Method="IsFile"/>
      </Installation>
    </ExperimentalRecipe>
   
    <!--Platform Name="QNX" Supported="false"/-->
  </ExternalLibrary>
</FslBuildGen>
