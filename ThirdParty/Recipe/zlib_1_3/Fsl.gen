<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../FslBuildGen.xsd">
  <ExternalLibrary Name="Recipe.zlib_1_3" CreationYear="2017">
    <Default.Platform.Supported Value="false"/>

    <Platform Name="Android" Supported="false">
      <ExperimentalRecipe Name="ZLIB" Version="1.3.2" FindTargetName="ZLIB::ZLIB">
        <Pipeline>
          <Download URL="https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz" Hash="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"/>
          <Unpack File="zlib-1.3.2.tar.gz" OutputPath="zlib-1.3.2"/>
          <CMakeBuild Project="" Target="install" Configuration="release" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/libz.a"/>
          <!--AddDLL Name="lib/libz.so"/-->
          <Path Name="include/zconf.h" Method="IsFile"/>
          <Path Name="include/zlib.h" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>

    
    <Platform Name="Ubuntu;QNX" Supported="true">
      <ExperimentalRecipe Name="ZLIB" Version="1.3.2" FindTargetName="ZLIB::ZLIB">
        <Pipeline>
          <Download URL="https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz" Hash="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"/>
          <Unpack File="zlib-1.3.2.tar.gz" OutputPath="zlib-1.3.2"/>
          <CMakeBuild Project="" Target="install" Configuration="release" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <!--AddLib Name="lib/libz.a"/-->
          <AddDLL Name="lib/libz.so"/>
          <Path Name="include/zconf.h" Method="IsFile"/>
          <Path Name="include/zlib.h" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>

    <Platform Name="Windows" Supported="true">
      <ExperimentalRecipe Name="ZLIB" Version="1.3.2">
        <Pipeline>
          <Download URL="https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz" Hash="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"/>
