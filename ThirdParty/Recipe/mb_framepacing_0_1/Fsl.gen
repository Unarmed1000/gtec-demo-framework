<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../FslBuildGen.xsd">
  <ExternalLibrary Name="Recipe.mb_framepacing_0_1" CreationYear="2026">
    <Default.Platform.Supported Value="false"/>

    <!-- There is no sdk-v0.1.0 release yet, so we pin a commit. Switch to the release archive (URL + SHA256) once it is published -->
    <!-- mb_framepacing requires CMake 4.0+. The marker module, the experimental pacer module (only used by the
         FramePacing sample) and the core they link are built, the data module is not used -->
    <Platform Name="Apple;RDK_Yocto;Ubuntu;QNX;Emscripten" Supported="true">
      <ExperimentalRecipe Name="mb_framepacing" Version="0.1.0" Find="false">
        <Pipeline>
          <GitClone URL="https://github.com/Unarmed1000/mb-framepacing" Hash="d5cbc420ebd180fd91e81cb0c00eb536d86acf2c"/>
          <CMakeBuild Source="sdk/cpp" Project="mb_framepacing" Target="install" Configuration="release" Options="-DMB_FRAMEPACING_BUILD_DATA=OFF -DMB_FRAMEPACING_BUILD_PACER=ON -DMB_FRAMEPACING_BUILD_TESTS=OFF -DMB_FRAMEPACING_BUILD_TOOLS=OFF -DMB_FRAMEPACING_WARNINGS_AS_ERRORS=OFF" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/libmb_framepacing_pacer.a"/>
          <AddLib Name="lib/libmb_framepacing_marker.a"/>
          <AddLib Name="lib/libmb_framepacing_core.a"/>
          <Path Name="include/mb/framepacing/marker/FrameMarker.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/pacer/FramePacer.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/core/Version.hpp" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>

    <!-- The CMake used for Android builds can be older than 4.0, with the tests disabled the library only uses CMake 3.30 features
         so the minimum version is lowered for Android only -->
    <Platform Name="Android" Supported="true">
      <ExperimentalRecipe Name="mb_framepacing" Version="0.1.0" Find="false">
        <Pipeline>
          <GitClone URL="https://github.com/Unarmed1000/mb-framepacing" Hash="d5cbc420ebd180fd91e81cb0c00eb536d86acf2c"/>
          <Copy>
            <GitApply From="{RECIPE_PATH}/android-cmake-minimum-version.patch"/>
          </Copy>
          <CMakeBuild Source="sdk/cpp" Project="mb_framepacing" Target="install" Configuration="release" Options="-DMB_FRAMEPACING_BUILD_DATA=OFF -DMB_FRAMEPACING_BUILD_PACER=ON -DMB_FRAMEPACING_BUILD_TESTS=OFF -DMB_FRAMEPACING_BUILD_TOOLS=OFF -DMB_FRAMEPACING_WARNINGS_AS_ERRORS=OFF" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/libmb_framepacing_pacer.a"/>
          <AddLib Name="lib/libmb_framepacing_marker.a"/>
          <AddLib Name="lib/libmb_framepacing_core.a"/>
          <Path Name="include/mb/framepacing/marker/FrameMarker.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/pacer/FramePacer.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/core/Version.hpp" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>

    <Platform Name="Windows" Supported="true">
      <ExperimentalRecipe Name="mb_framepacing" Version="0.1.0" Find="false">
        <Pipeline>
          <GitClone URL="https://github.com/Unarmed1000/mb-framepacing" Hash="d5cbc420ebd180fd91e81cb0c00eb536d86acf2c"/>
          <CMakeBuild Source="sdk/cpp" Project="mb_framepacing" Target="install" Configuration="debug;release" Options="-DMB_FRAMEPACING_BUILD_DATA=OFF -DMB_FRAMEPACING_BUILD_PACER=ON -DMB_FRAMEPACING_BUILD_TESTS=OFF -DMB_FRAMEPACING_BUILD_TOOLS=OFF -DMB_FRAMEPACING_WARNINGS_AS_ERRORS=OFF -DCMAKE_DEBUG_POSTFIX=d" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/mb_framepacing_pacer.lib" DebugName="lib/mb_framepacing_pacerd.lib"/>
          <AddLib Name="lib/mb_framepacing_marker.lib" DebugName="lib/mb_framepacing_markerd.lib"/>
          <AddLib Name="lib/mb_framepacing_core.lib" DebugName="lib/mb_framepacing_cored.lib"/>
          <Path Name="include/mb/framepacing/marker/FrameMarker.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/pacer/FramePacer.hpp" Method="IsFile"/>
          <Path Name="include/mb/framepacing/core/Version.hpp" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>
  </ExternalLibrary>
</FslBuildGen>
