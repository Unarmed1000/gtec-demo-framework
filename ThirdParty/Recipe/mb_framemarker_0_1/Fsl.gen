<?xml version="1.0" encoding="UTF-8"?>
<FslBuildGen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../FslBuildGen.xsd">
  <ExternalLibrary Name="Recipe.mb_framemarker_0_1" CreationYear="2026">
    <Default.Platform.Supported Value="false"/>

    <!-- mb_framemarker requires CMake 4.0+ so only the platforms where that is the norm are enabled -->
    <!-- There is no marker-v0.1.0 release yet, so we pin a commit. Switch to the release archive (URL + SHA256) once it is published -->
    <Platform Name="Apple;Ubuntu" Supported="true">
      <ExperimentalRecipe Name="mb_framemarker" Version="0.1.0" Find="false">
        <Pipeline>
          <GitClone URL="https://github.com/Unarmed1000/mb-framepacing" Hash="7c5b03b8165eb04fc699b89f8d32a21f73b35a26"/>
          <CMakeBuild Source="marker/cpp" Project="mb_framemarker" Target="install" Configuration="release" Options="-DMB_FRAMEMARKER_BUILD_TESTS=OFF -DMB_FRAMEMARKER_BUILD_TOOLS=OFF -DMB_FRAMEMARKER_WARNINGS_AS_ERRORS=OFF" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/libmb_framemarker.a"/>
          <Path Name="include/mb/framemarker/FrameMarker.hpp" Method="IsFile"/>
          <Path Name="include/mb/framemarker/Version.hpp" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>

    <Platform Name="Windows" Supported="true">
      <ExperimentalRecipe Name="mb_framemarker" Version="0.1.0" Find="false">
        <Pipeline>
          <GitClone URL="https://github.com/Unarmed1000/mb-framepacing" Hash="7c5b03b8165eb04fc699b89f8d32a21f73b35a26"/>
          <CMakeBuild Source="marker/cpp" Project="mb_framemarker" Target="install" Configuration="debug;release" Options="-DMB_FRAMEMARKER_BUILD_TESTS=OFF -DMB_FRAMEMARKER_BUILD_TOOLS=OFF -DMB_FRAMEMARKER_WARNINGS_AS_ERRORS=OFF -DCMAKE_DEBUG_POSTFIX=d" OutputPath="_Install"/>
        </Pipeline>
        <Installation>
          <AddHeaders Name="include"/>
          <AddLib Name="lib/mb_framemarker.lib" DebugName="lib/mb_framemarkerd.lib"/>
          <Path Name="include/mb/framemarker/FrameMarker.hpp" Method="IsFile"/>
          <Path Name="include/mb/framemarker/Version.hpp" Method="IsFile"/>
        </Installation>
      </ExperimentalRecipe>
    </Platform>
  </ExternalLibrary>
</FslBuildGen>
